{
  "rewrites": [
    {
      "source": "/",
      "destination": "/mythoria-partie1/html/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/mythoria-partie1/html/index.html"
    },
    {
      "source": "/shop.html",
      "destination": "/mythoria-partie1/html/shop.html"
    },
    {
      "source": "/opening.html",
      "destination": "/mythoria-partie1/html/opening.html"
    },
    {
      "source": "/grimoire.html",
      "destination": "/mythoria-partie1/html/grimoire.html"
    },
    {
      "source": "/deck.html",
      "destination": "/mythoria-partie1/html/deck.html"
    },
    {
      "source": "/style.css",
      "destination": "/mythoria-partie1/html/style.css"
    },
    {
      "source": "/html/:path*",
      "destination": "/mythoria-partie1/html/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/mythoria-partie1/js/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/mythoria-partie1/images/:path*"
    },
    {
      "source": "/docs/:path*",
      "destination": "/mythoria-partie1/docs/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/mythoria-partie2/assets/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/arena.html",
      "destination": "/mythoria-partie2/arena.html",
      "permanent": false
    }
  ]
}
